# Copy this file to .env (same folder) and fill in values. Never commit .env.

# Optional. Without a key the app runs in clearly labelled fallback mode.
GROQ_API_KEY=
# The brief specifies Llama 3.1 8B (llama-3.1-8b-instant), but Groq retired it
# for free/developer keys. openai/gpt-oss-20b is Groq's recommended replacement
# and is verified working. To try Llama: GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Leave empty to use local SQLite (backend/tickets.db).
# Neon example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Used by the Streamlit frontend.
BACKEND_URL=http://127.0.0.1:8000

# Optional tuning (defaults shown).
SIMILARITY_THRESHOLD=0.15
TOP_K=5
GROQ_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2

# Set to true on cloud hosts with a temporary disk: seeds tickets at startup.
AUTO_SEED=false
